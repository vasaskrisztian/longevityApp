# Transactional email (registration verification, password reset) via
# Resend — https://resend.com/api-keys. Leave both unset to fall back to
# logging emails to the console instead of sending them (local dev, CI).
RESEND_API_KEY=
# Must be a verified sender on the Resend account above once you're past
# onboarding@resend.dev's test-mode restrictions (it can only deliver to
# the account owner's own address) — e.g. "Longevity Klub <no-reply@kardi-soft.hu>".
EMAIL_FROM=
