// ==============================================================================
// Longevity App — Prisma Schema (proposal)
// Oura-first, multi-wearable-ready health & wellness platform
// PostgreSQL. See ARCHITECTURE.md for the reasoning behind each model.
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  // Driver adapters (node-postgres) hand all socket I/O to the well-tested
  // `pg` package instead of Prisma's bundled Rust query engine. Switched to
  // after diagnosing a production hang: sync jobs (and, separately, plain
  // read queries from the web app) would freeze forever inside a DB write/
  // read with Postgres itself reporting the connection as idle — i.e. the
  // response had already arrived, but the engine's own async runtime never
  // surfaced it back to Node, and critically this appeared to freeze the
  // whole event loop (even our own 4-minute JS-level watchdog's setTimeout
  // never fired). Adding `connect_timeout`/`socket_timeout` to DATABASE_URL
  // did not help, which points at the engine's native (N-API) layer rather
  // than anything a connection-string parameter can reach. `pg`'s pool
  // (src/lib/db/prisma.ts) uses plain non-blocking Node sockets with TCP
  // keepalive and explicit statement/query timeouts, none of which share
  // that failure mode.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

/// Phase 13 (Creators & Followers): a second, independent dimension from
/// UserRole (USER/ADMIN is about *system* permissions; this is about
/// *content* — whose protocols/challenges/health data can ever be shown to
/// other users at all). An admin is not automatically a CREATOR and a
/// CREATOR is not automatically an admin. Only `requireAdmin()` can grant
/// CREATOR (see admin.service.ts's setUserAccountType) — per the product
/// decision, nobody self-serves their way to a public profile.
enum AccountType {
  MEMBER
  CREATOR
}

/// Per-resource publish flag on Protocol/Challenge. Defaults to PRIVATE
/// everywhere — a resource only ever becomes visible to anyone but its
/// owner (or an admin) when ALL of: the owner is a CREATOR, the owner has
/// given explicit publicProfileConsentAt (a separate GDPR-style consent
/// from the registration-time termsAcceptedAt/privacyAcceptedAt — "make my
/// data public" is a materially bigger disclosure than "I agreed to the
/// ToS"), AND the resource itself is set to PUBLIC. All three gates are
/// re-checked on every read of creators.service.ts's public-profile query,
/// not just at write time — see that module's doc comment.
enum Visibility {
  PRIVATE
  PUBLIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  ATHLETE
}

enum ActivityType {
  STRENGTH_TRAINING
  WALKING
  RUNNING
  CYCLING
  SWIMMING
  YOGA
  PILATES
  HIIT
  CROSSFIT
  TEAM_SPORTS
  OTHER
}

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETOGENIC
  LOW_CARB
  MEDITERRANEAN
  OTHER
}

enum GoalType {
  SLEEP_IMPROVEMENT
  STRESS_REDUCTION
  WEIGHT_LOSS
  WEIGHT_GAIN
  MUSCLE_GAIN
  RECOVERY
  CARDIOVASCULAR_FITNESS
  GENERAL_HEALTH
  ENERGY
  PERFORMANCE
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

// The three metrics a Challenge can be defined against — see the Challenge
// model's own doc comment for the "X occurrences of <metric> above Y, within
// Z days" shape this drives.
enum ChallengeType {
  SLEEP_SCORE
  DAILY_STEPS
  WEEKLY_WORKOUTS
}

enum SupplementFrequency {
  DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  WEEKLY
  AS_NEEDED
  OTHER
}

enum SupplementTiming {
  MORNING
  AFTERNOON
  EVENING
  BEFORE_MEAL
  AFTER_MEAL
  BEFORE_SLEEP
  BEFORE_WORKOUT
  AFTER_WORKOUT
  OTHER
}

// Kept intentionally generic — new providers are additive, never a breaking change.
enum WearableProvider {
  OURA
  GARMIN
  WHOOP
  FITBIT
  APPLE_HEALTH
  SAMSUNG_HEALTH
  WITHINGS
  OTHER
}

enum WearableConnectionStatus {
  CONNECTED
  DISCONNECTED
  AUTH_REQUIRED
  ERROR
}

enum SyncJobType {
  INITIAL
  DAILY
  MANUAL
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// dataType discriminator for raw provider payloads
enum WearableDataType {
  DAILY_SLEEP
  DAILY_READINESS
  DAILY_ACTIVITY
  HEART_RATE
  WORKOUT
  SPO2
  OTHER
}

// ------------------------------------------------------------------
// Identity & auth
// ------------------------------------------------------------------

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  emailVerifiedAt  DateTime?
  passwordHash     String?

  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)

  // Phase 13: see the AccountType/Visibility doc comments above. A MEMBER
  // can follow CREATORs and upload their own data like anyone else — this
  // field only governs whether THIS account's own content can ever be made
  // public, not whether it can use the rest of the app.
  accountType            AccountType @default(MEMBER)
  // Set the moment a CREATOR explicitly opts their account into having a
  // public profile at all (src/modules/creators/creators.service.ts's
  // setPublicProfileConsent) — null means "no public profile", full stop,
  // even if accountType is CREATOR (an admin can grant the *ability*
  // without the person having opted in yet). Demoting back to MEMBER, or
  // the creator revoking consent, clears this AND flips every one of their
  // Protocol/Challenge rows back to PRIVATE in the same transaction (see
  // admin.service.ts/creators.service.ts) — content never stays public
  // once either gate closes.
  publicProfileConsentAt DateTime?

  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?

  lastLoginAt      DateTime?

  // Set once the onboarding wizard (Personal → Exercise → Nutrition, Phase 2)
  // has been completed. Gates dashboard/trends/profile access via
  // requireOnboardedUserForPage() — see src/lib/auth/page-guards.ts.
  onboardingCompletedAt DateTime?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  profile            Profile?
  exerciseProfile     ExerciseProfile?
  nutritionProfile    NutritionProfile?
  supplements         Supplement[]
  goals               Goal[]
  protocols           Protocol[]
  challenges          Challenge[]

  // Phase 13: self-relation via the join model Follow. "Following" is the
  // rows where this user is the follower; "followers" is the rows where
  // this user is the creator being followed. Followers are anonymous to
  // each other AND to the creator by product decision — nothing in this
  // codebase ever selects Follow.follower for a creator-facing read, only
  // Follow.count() (see creators.service.ts's getFollowerCount) — so the
  // "followers" relation exists for the schema/cascade-delete wiring, not
  // because any query walks it to list identities.
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
  inBodyMeasurements  InBodyMeasurement[]
  wearableConnections WearableConnection[]
  dailyHealthMetrics  DailyHealthMetric[]
  workouts            Workout[]
  syncJobs            SyncJob[]
  wearableRawRecords  WearableRawRecord[]
  oauthStates         OAuthState[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Auth.js (NextAuth) linkage — enables Google OAuth later without a schema change.
  accounts Account[]
  sessions Session[]

  // Audit trail where this user was the actor or the target
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Profile {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName   String
  birthDate  DateTime  @db.Date
  gender     Gender?
  heightCm   Decimal   @db.Decimal(5, 1)
  weightKg   Decimal   @db.Decimal(5, 1)
  timezone   String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("profiles")
}

model ExerciseProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityLevel         ActivityLevel
  weeklyWorkoutCount    Int?
  avgWorkoutDurationMin Int?
  activityTypes         ActivityType[]
  customActivities      String[]       @default([])

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("exercise_profiles")
}

model NutritionProfile {
  id                String     @id @default(uuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietType          DietType
  dailyMealCount    Int?
  dailyCaloriesKcal Int?
  dailyProteinGrams Int?
  allergies         String[]   @default([])
  intolerances      String[]   @default([])
  avoidedFoods      String[]   @default([])
  notes             String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("nutrition_profiles")
}

model Supplement {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  dosage    Decimal             @db.Decimal(8, 2)
  unit      String
  frequency SupplementFrequency
  timing    SupplementTiming?
  notes     String?
  active    Boolean             @default(true)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([userId, active])
  @@map("supplements")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        GoalType
  name        String
  description String?
  targetValue Decimal?   @db.Decimal(10, 2)
  targetUnit  String?
  targetDate  DateTime?  @db.Date
  status      GoalStatus @default(ACTIVE)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@map("goals")
}

/// A named target plan: the numbers a user is trying to hit (sleep score,
/// sleep duration, weekly workouts, daily active calories) plus the
/// supplements that go with it. A user can keep several protocols (e.g. "Cutting"
/// vs "Base building") but only one is ever `isActive` at a time — that's the
/// one the dashboard compares today's actuals against. Enforced in
/// protocols.service.ts (unset the previous active row in the same
/// transaction), not a DB constraint, matching this codebase's existing
/// preference for application-level invariants over partial unique indexes.
model Protocol {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean  @default(false)

  targetSleepScore          Int?
  targetSleepMinutes        Int?
  targetWeeklyWorkouts      Int?
  targetDailyActiveCalories Int?

  // Phase 13: PRIVATE always, regardless of what a caller sends, unless the
  // owner is a consenting CREATOR — enforced in the Route Handler (see
  // src/app/api/protocols/route.ts and .../[id]/route.ts), not here; this
  // column alone does not imply anything is actually reachable by anyone
  // but the owner — creators.service.ts's public-profile query re-checks
  // the owner's accountType/publicProfileConsentAt on every read too.
  visibility  Visibility @default(PRIVATE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplements ProtocolSupplement[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, visibility])
  @@map("protocols")
}

/// A supplement target line within a Protocol — deliberately its own row
/// rather than reusing the Supplement model: this is "what the plan calls
/// for", not "what the user actually takes" (Supplement), so dosage/unit/
/// frequency/timing are all optional free-form targets, not a tracked
/// regimen. Replaced wholesale on every protocol update (delete + recreate
/// in protocols.service.ts) rather than diffed row-by-row.
model ProtocolSupplement {
  id         String    @id @default(uuid())
  protocolId String
  protocol   Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  name       String
  dosage     Decimal?  @db.Decimal(8, 2)
  unit       String?
  frequency  SupplementFrequency?
  timing     SupplementTiming?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([protocolId])
  @@map("protocol_supplements")
}

/// A time-boxed, pass/fail commitment: "reach `requiredCount` days/weeks
/// where `type`'s metric exceeds `threshold`, within `windowDays` of
/// activation." Unlike Protocol (an ongoing target with no end date), a
/// Challenge has a hard expiry once activated and a pass/fail outcome —
/// but that outcome is computed on read (see challenges.service.ts's
/// computeProgress), not stored as a status column, matching this
/// codebase's preference for derived state over stored state that can
/// drift (dashboard.service.ts's getWeeklyWorkoutCount does the same). A
/// user can have several challenges active at once — nothing here demotes
/// another row, unlike Protocol's single-active invariant.
model Challenge {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          ChallengeType
  // Optional custom label; the UI derives a readable description from the
  // fields below when this is blank (e.g. "5 nights above 80 sleep score,
  // within 14 days").
  name          String?

  requiredCount Int
  threshold     Int
  windowDays    Int

  // Both null until the user starts the challenge (activateChallenge) — a
  // challenge can be configured ahead of time and started whenever the user
  // is ready, since the expiry is relative to activation, not creation.
  // Once set, the challenge's own fields become read-only (enforced in the
  // [id] route, not here) — changing the terms mid-challenge would defeat
  // the point of committing to it.
  activatedAt   DateTime?
  expiresAt     DateTime?

  // Phase 13: same PRIVATE-unless-consenting-CREATOR rule as
  // Protocol.visibility above — see that field's doc comment.
  visibility    Visibility    @default(PRIVATE)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([userId, activatedAt])
  @@index([userId, visibility])
  @@map("challenges")
}

/// Phase 13: a MEMBER (or CREATOR) following a CREATOR's public profile.
/// Deliberately its own join table rather than a scalar array on User —
/// needs its own `createdAt` and a stable row to delete on unfollow.
/// followerId/creatorId are NOT role-checked by a DB constraint (Prisma/
/// Postgres can't express "creatorId must point at a CREATOR" declaratively)
/// — creators.service.ts's followCreator() checks that before writing.
model Follow {
  id         String   @id @default(uuid())

  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  creatorId  String
  creator    User     @relation("Followers", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  // A user can only follow a given creator once — followCreator() treats a
  // unique-constraint violation as "already following" (idempotent), not
  // an error.
  @@unique([followerId, creatorId])
  @@index([creatorId])
  @@map("follows")
}

/// A single InBody body-composition scan, entered by uploading a photo/scan
/// of the printed report. All ten measurement fields are nullable: OCR
/// confidence on a phone photo of a dense, bar-chart-heavy printed form
/// varies a lot field-to-field (see inbody-parser.ts's top comment), so a
/// field this record's OCR pass couldn't confidently read is left null
/// rather than stored as a guessed value — the user can fill or correct any
/// field afterward from the InBody page. `rawOcrText` and the original image
/// are always kept precisely so that correction is possible.
model InBodyMeasurement {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Parsed from the report's own "Teszt dátuma/ideje" / test date field when
  // recognizable; falls back to the upload time otherwise (see
  // inbody-parser.ts's parseMeasuredAt).
  measuredAt DateTime

  weightKg               Decimal? @db.Decimal(5, 1)
  bodyFatPercentage      Decimal? @db.Decimal(4, 1)
  skeletalMuscleMassKg   Decimal? @db.Decimal(5, 1)
  fatFreeMassKg          Decimal? @db.Decimal(5, 1)
  bmi                    Decimal? @db.Decimal(4, 1)
  inBodyScore            Int?
  visceralFatLevel       Int?
  basalMetabolicRateKcal Int?
  totalBodyWaterL        Decimal? @db.Decimal(5, 1)
  ecwRatio               Decimal? @db.Decimal(5, 3)

  // The uploaded photo/scan itself, kept alongside the parsed values so the
  // original document can always be reviewed against what was extracted.
  // Stored in Postgres rather than external object storage: this app has no
  // blob-storage credentials configured, and a personal user's occasional
  // scan uploads (a handful of MB every few weeks) are nowhere near a scale
  // where this matters -- see docs/ci-cd-setup.md for the deploy topology.
  imageData        Bytes
  imageContentType String
  imageFilename    String?

  // The full text OCR read off the image (both the left and right report
  // columns, concatenated) -- kept even when every field parses cleanly, so
  // a value the parser missed or misread can be looked up and corrected by
  // hand instead of re-uploading the photo.
  rawOcrText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, measuredAt])
  @@map("inbody_measurements")
}

// ------------------------------------------------------------------
// Wearable domain (provider-agnostic)
// ------------------------------------------------------------------

model WearableConnection {
  id                   String                   @id @default(uuid())
  userId               String
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider             WearableProvider
  externalUserId       String?

  status               WearableConnectionStatus @default(DISCONNECTED)

  connectedAt          DateTime?
  disconnectedAt       DateTime?

  grantedScopes        String[]                 @default([])

  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncStatus       SyncJobStatus?

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  credential           EncryptedCredential?
  rawRecords           WearableRawRecord[]
  syncJobs             SyncJob[]

  // A user may reconnect the same provider later (e.g. after a full revoke),
  // or in the future run two accounts of different providers side by side —
  // so this is NOT unique on (userId, provider) alone; see ARCHITECTURE.md §11.
  @@index([userId])
  @@index([userId, provider])
  @@index([status])
  @@map("wearable_connections")
}

// OAuth credentials live in their own table, encrypted at rest, and are never
// exposed outside integrations/wearable/*. Never joined into API responses.
model EncryptedCredential {
  id                   String             @id @default(uuid())
  connectionId         String             @unique
  connection           WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext + metadata (see EncryptionService in ARCHITECTURE.md §16)
  accessTokenCipher    String
  accessTokenIv        String
  accessTokenAuthTag   String
  accessTokenExpiresAt DateTime

  refreshTokenCipher   String
  refreshTokenIv       String
  refreshTokenAuthTag  String

  // Concurrency control for the rotating-refresh-token race (ARCHITECTURE.md §6)
  refreshVersion       Int                @default(0)
  refreshLockedAt       DateTime?
  refreshLockedBy       String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("encrypted_credentials")
}

model WearableRawRecord {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  provider     WearableProvider
  dataType     WearableDataType
  externalId   String
  dataDate     DateTime           @db.Date
  payload      Json
  fetchedAt    DateTime           @default(now())

  // Idempotency key: the same provider record fetched twice must upsert, not duplicate.
  @@unique([connectionId, dataType, externalId], name: "uniq_raw_record")
  @@index([userId, dataDate])
  @@index([provider, dataType])
  @@map("wearable_raw_records")
}

// ------------------------------------------------------------------
// Normalized platform data (what the dashboard actually reads)
// ------------------------------------------------------------------

model DailyHealthMetric {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime @db.Date

  sleepScore            Int?
  readinessScore        Int?
  activityScore         Int?

  totalSleepMinutes     Int?
  deepSleepMinutes      Int?
  remSleepMinutes       Int?
  lightSleepMinutes     Int?
  awakeMinutes          Int?
  sleepEfficiencyPct    Decimal? @db.Decimal(5, 2)
  sleepLatencyMinutes   Int?
  bedtimeStart          DateTime?
  bedtimeEnd            DateTime?

  restingHeartRate      Int?
  averageHrv            Decimal? @db.Decimal(6, 2)
  temperatureDeviationC Decimal? @db.Decimal(4, 2)

  steps                 Int?
  activeCalories        Int?
  totalCalories         Int?
  walkingEquivalentMin  Int?
  sedentaryMinutes      Int?

  spo2Average           Decimal? @db.Decimal(5, 2)

  // Which providers contributed to this row (a day can be a merge of multiple
  // wearables once more providers are added).
  sourceProviders       WearableProvider[] @default([])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_health_metrics")
}

model Workout {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider     WearableProvider
  externalId   String

  activityType String
  startedAt    DateTime
  endedAt      DateTime
  durationMin  Int
  calories     Int?
  distanceM    Decimal?          @db.Decimal(10, 2)
  intensity    String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([provider, externalId])
  @@index([userId, startedAt])
  @@map("workouts")
}

// ------------------------------------------------------------------
// Sync orchestration
// ------------------------------------------------------------------

model SyncJob {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider        WearableProvider

  type            SyncJobType
  status          SyncJobStatus      @default(QUEUED)

  startedAt       DateTime?
  finishedAt      DateTime?

  recordsFetched  Int                @default(0)
  recordsCreated  Int                @default(0)
  recordsUpdated  Int                @default(0)

  retryCount      Int                @default(0)

  errorCode       String?
  errorMessage    String?

  createdAt       DateTime           @default(now())

  @@index([userId])
  @@index([connectionId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_jobs")
}

// ------------------------------------------------------------------
// OAuth CSRF state (short-lived, single-use)
// ------------------------------------------------------------------

model OAuthState {
  id           String            @id @default(uuid())
  state        String            @unique
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     WearableProvider

  redirectUri  String?
  codeVerifier String?           // PKCE, if the provider supports/requires it

  usedAt       DateTime?
  expiresAt    DateTime

  createdAt    DateTime          @default(now())

  @@index([expiresAt])
  @@map("oauth_states")
}

// ------------------------------------------------------------------
// Password reset / email verification (app-managed, separate from Auth.js
// VerificationToken so we can enforce single-use + hashing explicitly)
// ------------------------------------------------------------------

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique
  usedAt      DateTime?
  expiresAt   DateTime

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String    @unique
  usedAt      DateTime?
  expiresAt   DateTime

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ------------------------------------------------------------------
// Auth.js (NextAuth) — enables Google login later without a data model change.
// Credentials login uses JWT sessions and never needs these rows; they only
// populate once an OAuth identity provider (e.g. Google) is enabled.
// ------------------------------------------------------------------

model Account {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------------
// Audit log — admin actions + security-relevant events. Never stores
// tokens, passwords, or raw health payloads (see ARCHITECTURE.md §10 / §44).
// ------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())

  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action       String
  entityType   String?
  entityId     String?

  metadata     Json?

  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
