{
  "expo": {
    "name": "Longevity Klub",
    "slug": "longevity-klub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "longevityklub",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.longevityklub",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "hu.longevityklub"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Longevity Klub to access your photos to upload an InBody scan report.",
          "cameraPermission": "Allow Longevity Klub to use your camera to photograph an InBody scan report."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3793343d-6d4c-4116-a2ab-b91b80044642"
      }
    },
    "owner": "vasas.krisztian"
  }
}
